{"cells": [{"cell_type": "markdown", "metadata": {}, "source": ["# UTS Graf Sains Data - RetailRocket (Neo4j)\n"]}, {"cell_type": "markdown", "metadata": {}, "source": ["## 1) Setup & Import Library"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["import os\n", "import random\n", "import math\n", "import numpy as np\n", "import pandas as pd\n", "import networkx as nx\n", "import matplotlib.pyplot as plt\n", "\n", "from dotenv import load_dotenv\n", "from neo4j import GraphDatabase\n", "from sklearn.metrics.pairwise import cosine_similarity\n", "\n", "pd.set_option('display.max_columns', None)\n", "print('Library siap')"]}, {"cell_type": "markdown", "metadata": {}, "source": ["## 2) Koneksi ke Neo4j"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["load_dotenv(override=True)\n", "\n", "URI = os.getenv('NEO4J_URI')\n", "USER = os.getenv('NEO4J_USER') or os.getenv('NEO4J_USERNAME')\n", "PWD  = os.getenv('NEO4J_PASSWORD')\n", "\n", "print('URI:', URI)\n", "print('USER:', USER)\n", "print('PWD_EXIST:', bool(PWD))\n", "\n", "class Neo4jConn:\n", "    def __init__(self, uri, user, pwd):\n", "        self.driver = GraphDatabase.driver(uri, auth=(user,pwd))\n", "    def query(self, q, params=None):\n", "        with self.driver.session() as s:\n", "            res = s.run(q, params or {})\n", "            return [r.data() for r in res]\n", "    def close(self):\n", "        self.driver.close()\n", "\n", "conn = Neo4jConn(URI, USER, PWD)\n", "conn.query('RETURN 1 AS ok')\n", "print('Koneksi berhasil')"]}, {"cell_type": "markdown", "metadata": {}, "source": ["## 3) Eksplorasi & Konversi Timestamp"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["df = pd.read_csv('events.csv')\n", "print('Shape:', df.shape)\n", "print('Min ts:', df['timestamp'].min(), '| Max ts:', df['timestamp'].max())\n", "\n", "df['dt'] = pd.to_datetime(df['timestamp'], unit='ms')\n", "print('\\nRange waktu:', df['dt'].min(), 's/d', df['dt'].max())\n", "df[['timestamp','dt']].head()"]}, {"cell_type": "markdown", "metadata": {}, "source": ["## 4) Filter Periode P1 & P2 + Cek Overlap"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["P1_START = '2015-06-01'\n", "P1_END   = '2015-06-30'\n", "P2_START = '2015-09-01'\n", "P2_END   = '2015-09-30'\n", "\n", "mask_p1 = (df['dt'] >= P1_START) & (df['dt'] <= P1_END)\n", "mask_p2 = (df['dt'] >= P2_START) & (df['dt'] <= P2_END)\n", "\n", "df_p1 = df[mask_p1].copy()\n", "df_p2 = df[mask_p2].copy()\n", "\n", "print('=== JUMLAH DATA ===')\n", "print('P1:', len(df_p1), '| Visitor unik:', df_p1['visitorid'].nunique(), '| Item unik:', df_p1['itemid'].nunique())\n", "print('P2:', len(df_p2), '| Visitor unik:', df_p2['visitorid'].nunique(), '| Item unik:', df_p2['itemid'].nunique())\n", "\n", "u1 = set(df_p1['visitorid'])\n", "u2 = set(df_p2['visitorid'])\n", "overlap = u1 & u2\n", "\n", "print('\\n=== OVERLAP USER ===')\n", "print('User yang muncul di P1 & P2:', len(overlap))\n", "print('Persentase dari user P1:', round(len(overlap)/len(u1)*100,2),'%')\n", "print('Persentase dari user P2:', round(len(overlap)/len(u2)*100,2),'%')\n", "\n", "df_p1.to_csv('events_p1_filtered.csv', index=False)\n", "df_p2.to_csv('events_p2_filtered.csv', index=False)\n", "print('\\nTersimpan: events_p1_filtered.csv & events_p2_filtered.csv')"]}, {"cell_type": "markdown", "metadata": {}, "source": ["## 5) Import Data P1 ke Neo4j (Visitor - Item - INTERACTED)"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["df_p1_imp = pd.read_csv('events_p1_filtered.csv')\n", "print('Data P1:', df_p1_imp.shape)\n", "\n", "conn.query(\"CREATE CONSTRAINT visitor_id IF NOT EXISTS FOR (v:Visitor) REQUIRE v.id IS UNIQUE\")\n", "conn.query(\"CREATE CONSTRAINT item_id IF NOT EXISTS FOR (i:Item) REQUIRE i.id IS UNIQUE\")\n", "\n", "BATCH = 5000\n", "total = 0\n", "for i in range(0, len(df_p1_imp), BATCH):\n", "    batch = df_p1_imp.iloc[i:i+BATCH]\n", "    rows = []\n", "    for _, r in batch.iterrows():\n", "        rows.append({'vid': int(r['visitorid']), 'iid': int(r['itemid']), 'ev': str(r['event']), 'ts': int(r['timestamp'])})\n", "    q = \"\"\"\n", "    UNWIND $rows AS row\n", "    MERGE (v:Visitor {id: row.vid})\n", "    MERGE (i:Item {id: row.iid})\n", "    MERGE (v)-[r:INTERACTED]->(i)\n", "    SET r.event = row.ev, r.ts = row.ts\n", "    \"\"\"\n", "    conn.query(q, {'rows': rows})\n", "    total += len(batch)\n", "    if (i // BATCH) % 4 == 0:\n", "        print(f'Imported {total}/{len(df_p1_imp)}')\n", "print('Selesai import P1:', total)"]}, {"cell_type": "markdown", "metadata": {}, "source": ["## 6) Komposisi Subgraph (2.1 No. 3)"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["res_nodes = conn.query(\"MATCH (n) RETURN labels(n)[0] AS label, count(*) AS jumlah ORDER BY jumlah DESC\")\n", "pd.DataFrame(res_nodes)"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["res_rel = conn.query(\"MATCH ()-[r]->() RETURN type(r) AS relType, count(*) AS jumlah ORDER BY jumlah DESC\")\n", "pd.DataFrame(res_rel)"]}, {"cell_type": "markdown", "metadata": {}, "source": ["## 7) VSM User-Item & Item-Item (2.1 No. 4-5)"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["import pandas as pd\n", "import numpy as np\n", "import scipy.sparse as sp\n", "\n", "if 'df_p1_imp' not in locals():\n", "    df_p1_imp = pd.read_csv('events_p1_filtered.csv')\n", "    print('df_p1_imp loaded:', df_p1_imp.shape)\n", "\n", "df2 = df_p1_imp[['visitorid', 'itemid']].drop_duplicates()\n", "print('Unique pairs:', len(df2))\n", "\n", "visitor_ids = sorted(df2['visitorid'].unique())\n", "item_ids = sorted(df2['itemid'].unique())\n", "v_to_idx = {v:i for i,v in enumerate(visitor_ids)}\n", "i_to_idx = {it:i for i,it in enumerate(item_ids)}\n", "\n", "rows = df2['visitorid'].map(v_to_idx).values\n", "cols = df2['itemid'].map(i_to_idx).values\n", "data = np.ones(len(rows), dtype=np.float32)\n", "\n", "ui_sparse = sp.csr_matrix((data, (rows, cols)), shape=(len(visitor_ids), len(item_ids)))\n", "print('Shape User-Item (sparse):', ui_sparse.shape)\n", "print('NNZ:', ui_sparse.nnz)\n"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["import numpy as np\n", "import scipy.sparse as sp\n", "\n", "co_item_sparse = ui_sparse.T @ ui_sparse\n", "co_item_sparse.setdiag(0)\n", "co_item_sparse.eliminate_zeros()\n", "print('Shape Item-Item (sparse):', co_item_sparse.shape)\n", "print('NNZ:', co_item_sparse.nnz)\n"]}, {"cell_type": "markdown", "metadata": {}, "source": ["## 8) Cosine Similarity & SIMILAR_TO (2.1 No. 6-7)"]}, {"cell_type": "markdown", "metadata": {}, "source": ["import numpy as np\n", "import pandas as pd\n", "from sklearn.preprocessing import normalize\n", "\n", "A = normalize(co_item_sparse, norm='l2', axis=1)\n", "sim_sparse = (A @ A.T)\n", "sim_sparse.setdiag(0)\n", "sim_sparse.eliminate_zeros()\n", "print('Shape Similarity (sparse):', sim_sparse.shape)\n", "print('NNZ:', sim_sparse.nnz)\n", "print('sim_sparse ready (no dense sim_df)')\n"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["THRESH = 0.3\n", "pairs = []\n", "\n", "# Iterasi langsung dari sim_sparse\n", "for a in range(sim_sparse.shape[0]):\n", "    row = sim_sparse.getrow(a)\n", "    if row.nnz == 0:\n", "        continue\n", "    cols = row.indices\n", "    data = row.data\n", "    idx_sorted = data.argsort()[::-1]\n", "    cnt = 0\n", "    for j in idx_sorted:\n", "        b = cols[j]\n", "        sc = data[j]\n", "        if b == a:\n", "            continue\n", "        if sc < THRESH:\n", "            continue\n", "        if a < b:\n", "            pairs.append({'a': int(item_ids[a]), 'b': int(item_ids[b]), 'score': float(sc)})\n", "            cnt += 1\n", "            if cnt >= 5:\n", "                break\n", "\n", "print('Jumlah pasangan yang akan ditulis:', len(pairs))\n", "\n", "seen = set()\n", "pairs_clean = []\n", "for p in pairs:\n", "    key = tuple(sorted((p['a'], p['b'])))\n", "    if key in seen: continue\n", "    seen.add(key)\n", "    pairs_clean.append({'a': key[0], 'b': key[1], 'score': p['score']})\n", "pairs = pairs_clean\n", "print('Setelah deduplicate:', len(pairs))\n"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Tulis relasi SIMILAR_TO (CREATE)\n", "if len(pairs) == 0:\n", "    print('Tidak ada pasangan untuk ditulis.')\n", "else:\n", "    BATCH_S = 5000\n", "    total = len(pairs)\n", "    for i in range(0, total, BATCH_S):\n", "        batchp = pairs[i:i+BATCH_S]\n", "        conn.query('''\n", "        UNWIND $pairs AS p\n", "        MATCH (a:Item {id: p.a}), (b:Item {id: p.b})\n", "        CREATE (a)-[:SIMILAR_TO {score: p.score}]->(b)\n", "        ''', {'pairs': batchp})\n", "        print(f'{min(i+BATCH_S, total)}/{total} pairs ditulis')\n", "    print(f'Selesai menulis SIMILAR_TO: {total}')\n"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["# Tulis relasi SIMILAR_TO ke Neo4j (Optimized: CREATE)\n", "if len(pairs) == 0:\n", "    print('Tidak ada pasangan untuk ditulis.')\n", "else:\n", "    BATCH_S = 5000\n", "    total = len(pairs)\n", "    print(f'Mulai menulis {total} pasangan dengan batch {BATCH_S}...')\n", "    for i in range(0, total, BATCH_S):\n", "        batchp = pairs[i:i+BATCH_S]\n", "        conn.query('''\n", "        UNWIND $pairs AS p\n", "        MATCH (a:Item {id: p.a}), (b:Item {id: p.b})\n", "        CREATE (a)-[:SIMILAR_TO {score: p.score}]->(b)\n", "        ''', {'pairs': batchp})\n", "        print(f'{min(i+BATCH_S, total)}/{total} pairs ditulis')\n", "    print(f'Selesai menulis SIMILAR_TO: {total}')\n"]}, {"cell_type": "markdown", "metadata": {}, "source": ["## 2.2 Analytics (Graph Data Science – User-Item Graph & Item-Based Similarity)\n", "\n", "### 2.2.1 Pemodelan Graf\n", "Interaksi pengguna–item dimodelkan sebagai *bipartite graph*:\n", "- Node `(:Visitor)` merepresentasikan `visitorid`\n", "- Node `(:Item)` merepresentasikan `itemid`\n", "- Relasi `(:Visitor)-[:INTERACTED]->(:Item)` merepresentasikan interaksi pada P1\n", "\n", "Diterapkan *unique constraint* pada `Visitor.id` dan `Item.id` serta proses import dilakukan secara *batch* untuk menjaga efisiensi.\n", "\n", "### 2.2.2 VSM, Co-occurrence & Cosine Similarity\n", "- Dibangun **User-Item Matrix** dalam bentuk `scipy.sparse.csr_matrix` (303.003 × 115.033) untuk mengatasi keterbatasan memori.\n", "- **Item-Item Co-occurrence Matrix** dihitung dengan $C = U^T U$, di mana $C_{ij}$ menyatakan jumlah pengguna yang berinteraksi dengan item $i$ dan $j$.\n", "- **Cosine Similarity** dihitung melalui normalisasi L2 baris ($A = \text{normalize}(C, norm='l2', axis=1)$) kemudian $\text{Sim} = A A^T$.\n", "- Diagonal di-set ke 0 (`setdiag(0)`) dan entri bernilai 0 dihilangkan (`eliminate_zeros`) untuk menjaga sparsity.\n", "\n", "### 2.2.3 Pembentukan Relasi SIMILAR_TO\n", "Relasi `(:Item)-[:SIMILAR_TO {score: ...}]-(:Item)` dibentuk dengan ketentuan:\n", "- **Similarity threshold** : `score >= 0.3`\n", "- **Top-5** item terdekat per item\n", "- Bersifat **undirected** dan dilakukan **deduplicate** pasangan\n", "- Ditulis ke Neo4j dengan `CREATE` per batch 5000 (lebih efisien dibanding `MERGE`)\n", "\n", "### 2.2.4 Item-Based KNN & Evaluasi\n", "- **Pemilihan user uji** : diambil secara acak dari overlap `P1 ∩ P2` dengan `SEED = 12345` (reproducible).\n", "- **Rekomendasi** : berdasarkan tetangga terdekat dari item-item yang pernah diinteraksi user di P1 melalui relasi `SIMILAR_TO`, mengesampingkan item yang sudah pernah dilihat, diambil **Top-5**.\n", "- **Ground Truth** : item yang diinteraksi user di P2.\n", "- **Metrik** :\n", "  - **Hit@5** : bernilai 1 jika minimal terdapat 1 item relevan di Top-5, 0 jika tidak.\n", "  - **NDCG@5** : mengukur kualitas peringkat berdasarkan DCG/IDCG dengan penalti posisi ($\\log_2(i+1)$), nilai berkisar 0–1.\n"]}, {"cell_type": "markdown", "metadata": {}, "source": ["## 9) Analytics - KNN, Hit@5, NDCG@5 (2.2)"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["SEED = 12345\n", "random.seed(SEED)\n", "np.random.seed(SEED)\n", "df_p2_cur = pd.read_csv('events_p2_filtered.csv')\n", "overlap_list = list(set(df_p1_imp['visitorid']) & set(df_p2_cur['visitorid']))\n", "uid = random.choice(overlap_list)\n", "print('SEED:', SEED, '| User:', uid)\n", "seen_p1 = set(df_p1_imp[df_p1_imp['visitorid']==uid]['itemid'].unique())\n", "print('Item di P1:', len(seen_p1))"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["cands = {}\n", "for it in seen_p1:\n", "    if it not in sim_df.index: continue\n", "    for nb, sc in sim_df.loc[it].sort_values(ascending=False).items():\n", "        if nb in seen_p1: continue\n", "        if sc <= 0: continue\n", "        if nb not in cands or sc > cands[nb]: cands[nb] = sc\n", "top5 = sorted(cands.items(), key=lambda x: x[1], reverse=True)[:5]\n", "print('Top-5:')\n", "for i,(it,sc) in enumerate(top5): print(f' #{i+1}: {it} | sim={sc:.4f}')\n", "print('\\n3 item diiklankan (k=5):')\n", "for it,sc in top5[:3]: print(' -', it)"]}, {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["gt_p2 = set(df_p2_cur[df_p2_cur['visitorid']==uid]['itemid'].unique())\n", "pred5 = [x[0] for x in top5]\n", "hit5 = 1.0 if len(set(pred5) & gt_p2) > 0 else 0.0\n", "print('Hit@5:', hit5)\n", "\n", "def dcg_at_k(rels,k):\n", "    dcg=0.0\n", "    for i in range(min(k,len(rels))):\n", "        if rels[i]: dcg += 1.0/math.log2(i+2)\n", "    return dcg\n", "\n", "rels = [1 if it in gt_p2 else 0 for it in pred5]\n", "dcg = dcg_at_k(rels,5)\n", "idcg = dcg_at_k(sorted(rels,reverse=True),5)\n", "ndcg5 = dcg/idcg if idcg>0 else 0.0\n", "print('NDCG@5:', ndcg5)\n", "print('Rels:', rels)"]}, {"cell_type": "markdown", "metadata": {}, "source": ["## Lampiran – Bukti Neo4j (Screenshots & Cypher)\n", "\n", "### A. Subgraph & Perhitungan Jumlah\n", "```cypher\n", "// 1) Sebelum penambahan similarity (hanya INTERACTED)\n", "MATCH (v:Visitor)-[:INTERACTED]->(i:Item)\n", "RETURN v, i\n", "LIMIT 50\n", "\n", "// 2) Sesudah penambahan similarity (Item–Item)\n", "MATCH (i1:Item)-[r:SIMILAR_TO]->(i2:Item)\n", "RETURN i1, r, i2\n", "LIMIT 50\n", "\n", "// 3) Jumlah node dan relasi\n", "MATCH (v:Visitor) RETURN count(v) AS total_visitor;\n", "MATCH (i:Item) RETURN count(i) AS total_item;\n", "MATCH ()-[r:INTERACTED]->() RETURN count(r) AS total_interacted;\n", "MATCH ()-[s:SIMILAR_TO]->() RETURN count(s) AS total_similar_to;\n", "```\n", "\n", "### B. Top-5 Similarity untuk Item Terpilih\n", "Ganti `<item_id>` dengan ID item yang ingin dicek.\n", "```cypher\n", "MATCH (i:Item {id: <item_id>})-[r:SIMILAR_TO]->(j:Item)\n", "RETURN j.id AS similar_item_id, r.score AS similarity_score\n", "ORDER BY r.score DESC\n", "LIMIT 5\n", "```\n", "\n"}
